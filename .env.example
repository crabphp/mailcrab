APP_NAME=Mailcrab
APP_URL=http://127.0.0.1:8090
APP_DEBUG=false
# Generate 64 random hexadecimal characters; never commit the real value.
APP_KEY=
SERVER_ADDRESS=tcp://127.0.0.1:8090
SERVER_WORKERS=1
DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=mailcrab;charset=utf8mb4"
DB_USERNAME=mailcrab
DB_PASSWORD=
DB_ASYNC=false
CACHE_STORE=file
DELIVERY_PROVIDER=fake
# SES onboarding is opt-in. Merely opening Settings never contacts AWS.
# Credentials stay on the server: prefer an IAM role or AWS_PROFILE; never paste keys into the UI.
SES_ENABLED=false
# Cloud-changing actions also require operator enablement AND per-action confirmation.
SES_SETUP_ENABLED=false
# Separate global live gate. NEVER enable without explicit user direction.
# Also needs CLI workspace authorization, fresh readiness, and unpausing.
SES_LIVE_ENABLED=false
AWS_REGION=us-east-1
SES_CONFIGURATION_PREFIX=mailcrab
# Existing SNS topic, in the same region. The app does not provision paid topics.
SES_SNS_TOPIC_ARN=
# Default stays fake. Explicitly authorized future jobs are routed per workspace;
# changing DELIVERY_PROVIDER to ses is deliberately rejected.
# Fake feedback authentication: generate another random secret.
FAKE_WEBHOOK_SECRET=
