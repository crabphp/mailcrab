{
  "name": "crabphp/mailcrab",
  "description": "Lean, consent-first newsletters on CrabPHP",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-openssl": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "aws/aws-php-sns-message-validator": "^1.10",
    "aws/aws-sdk-php": "^3.0",
    "crabphp/framework": "0.6.2"
  },
  "require-dev": {"phpunit/phpunit": "^12.0"},
  "autoload": {"psr-4": {"Mailcrab\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "repositories": [{"type": "path", "url": "../framework", "options": {"symlink": false, "versions": {"crabphp/framework": "0.6.2"}}}],
  "config": {"platform": {"php": "8.4.22"}, "sort-packages": true},
  "scripts": {"test": "@php vendor/bin/phpunit"}
}
